# Meta-hosted Coexistence onboarding
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
NEXT_PUBLIC_APP_URL=https://YOUR-CRM-HOST
META_GRAPH_VERSION=v26.0
# Public configuration ID used in the direct Meta onboarding link.
META_HOSTED_CONFIG_ID=3264827733702626
# Provider's server-only system token; used to fetch each hosted customer's business token.
# META_SYSTEM_USER_ACCESS_TOKEN=YOUR_SYSTEM_USER_TOKEN
# WHATSAPP_ACCESS_TOKEN is a fallback only when it contains the appropriate system token.
WHATSAPP_VERIFY_TOKEN=YOUR_RANDOM_VERIFY_TOKEN
CRM_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY
CRM_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
# Optional persistent data directory; default is data/ under the app.
# CRM_DATA_DIR=C:/persistent/hanif-crm
