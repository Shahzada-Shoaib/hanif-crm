# Copy this file to .env on the VPS and replace every placeholder.
POSTGRES_DB=hanifcrm
POSTGRES_USER=hanifcrm
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD

# Keep the username, password, host and database synchronized with the values above.
# URL-encode special characters in the password, or use an alphanumeric password.
DATABASE_URL=postgresql://hanifcrm:CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/hanifcrm

FRONTEND_URL=https://crm.example.com
